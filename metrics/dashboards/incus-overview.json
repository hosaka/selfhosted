              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #cpus"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "CPUs"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
