            "desc": false
          }
        ]
      }
    },
    {
      "id": 100,
      "type": "row",
      "title": "Node: $node",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "repeat": "node"
    },
    {
      "id": 101,
      "type": "stat",
      "title": "RAM",
      "description": "Memory in use excluding page cache and the ZFS ARC, which is shown separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "Used",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(node_memory_MemTotal_bytes{job=\"cluster\", node=\"$node\"}) - sum(node_memory_MemAvailable_bytes{job=\"cluster\", node=\"$node\"}) - (sum(node_zfs_arc_size{job=\"cluster\", node=\"$node\"}) or vector(0))",
          "legendFormat": "Used"
        },
        {
          "refId": "ARC",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(node_zfs_arc_size{job=\"cluster\", node=\"$node\"})",
          "legendFormat": "ZFS ARC"
        },
        {
          "refId": "Total",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(node_memory_MemTotal_bytes{job=\"cluster\", node=\"$node\"})",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal"
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "CPU",
      "description": "Average across all cores.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"cluster\", node=\"$node\", mode=\"idle\"}[$__rate_interval])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Root disk",
      "description": "The IncusOS root filesystem.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "refId": "Used",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(node_filesystem_size_bytes{job=\"cluster\", node=\"$node\", mountpoint=\"/\"}) - sum(node_filesystem_avail_bytes{job=\"cluster\", node=\"$node\", mountpoint=\"/\"})",
          "legendFormat": "Used"
        },
        {
          "refId": "Total",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(node_filesystem_size_bytes{job=\"cluster\", node=\"$node\", mountpoint=\"/\"})",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal"
      }
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Running instances",
      "description": "Containers and virtual machines.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(incus_boot_time_seconds{job=\"cluster\", node=\"$node\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        }
      }
    },
    {
      "id": 110,
      "type": "table",
      "title": "Instances on $node",
      "description": "CPU is the share of the CPUs the instance can use. RAM is the share of its memory limit in use, or of the member's memory for instances without a limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "cpus",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name, project, type) (incus_cpu_effective_total{job=\"cluster\", node=\"$node\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "cpu",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (name, project, type) (rate(incus_cpu_seconds_total{job=\"cluster\", node=\"$node\", mode=~\"user|system\"}[$__rate_interval])) / max by (name, project, type) (incus_cpu_effective_total{job=\"cluster\", node=\"$node\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "ram_used",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name, project, type) (incus_memory_MemTotal_bytes{job=\"cluster\", node=\"$node\"} - incus_memory_MemAvailable_bytes{job=\"cluster\", node=\"$node\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "ram",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - sum by (name, project, type) (incus_memory_MemAvailable_bytes{job=\"cluster\", node=\"$node\"}) / sum by (name, project, type) (incus_memory_MemTotal_bytes{job=\"cluster\", node=\"$node\"}))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "name": 0,
              "project": 1,
              "type": 2,
              "Value #cpus": 3,
              "Value #cpu": 4,
              "Value #ram_used": 5,
              "Value #ram": 6
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Instance"
              }
