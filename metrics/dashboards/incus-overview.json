{
  "uid": "incus-overview",
  "title": "Incus Overview",
  "description": "Cluster members and their instances: CPU, memory and disk per node.",
  "tags": [
    "cluster"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_boot_time_seconds{job=\"cluster\"}, node)",
          "refId": "node"
        },
        "definition": "label_values(node_boot_time_seconds{job=\"cluster\"}, node)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Cluster members",
      "description": "RAM leaves out the ZFS ARC, which ZFS gives back under memory pressure. Disk is the IncusOS root filesystem; ZFS pools is online when every pool on the member is. CPU temp is the hottest CPU sensor (coretemp, k10temp). OOM kills counts processes the kernel killed for lack of memory, on the host or in an instance.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "cpu",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (node) (100 * (1 - rate(node_cpu_seconds_total{job=\"cluster\", mode=\"idle\"}[5m])))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "cpu_temp",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (node) (node_hwmon_temp_celsius{job=\"cluster\"} * on (node, chip) group_left max by (node, chip) (node_hwmon_chip_names{job=\"cluster\", chip_name=~\"coretemp|k10temp\"}))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "ram",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - (sum by (node) (node_memory_MemAvailable_bytes{job=\"cluster\"}) + (sum by (node) (node_zfs_arc_size{job=\"cluster\"}) or sum by (node) (node_memory_MemTotal_bytes{job=\"cluster\"}) * 0)) / sum by (node) (node_memory_MemTotal_bytes{job=\"cluster\"}))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "ram_total",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node) (node_memory_MemTotal_bytes{job=\"cluster\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "oom",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (node) (clamp_min(node_vmstat_oom_kill{job=\"cluster\"} - node_vmstat_oom_kill{job=\"cluster\"} offset 1d, 0))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "disk",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - sum by (node) (node_filesystem_avail_bytes{job=\"cluster\", mountpoint=\"/\"}) / sum by (node) (node_filesystem_size_bytes{job=\"cluster\", mountpoint=\"/\"}))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "disk_total",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node) (node_filesystem_size_bytes{job=\"cluster\", mountpoint=\"/\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "pools",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (node) (node_zfs_zpool_state{job=\"cluster\", state=\"online\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "instances",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (node) (incus_boot_time_seconds{job=\"cluster\"}) or sum by (node) (node_boot_time_seconds{job=\"cluster\"}) * 0",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "node": 0,
              "Value #cpu": 1,
              "Value #cpu_temp": 2,
              "Value #ram": 3,
              "Value #ram_total": 4,
              "Value #oom": 5,
              "Value #disk": 6,
              "Value #disk_total": 7,
              "Value #pools": 8,
              "Value #instances": 9
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "node"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Node"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #cpu"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "CPU"
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #cpu_temp"
