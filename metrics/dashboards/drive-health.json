    {
      "id": 9,
      "type": "timeseries",
      "title": "New drive errors",
      "description": "How much each error counter grew per interval; only growth is drawn, so a bar means that drive logged new errors then. Reallocated, pending, uncorrectable and reported uncorrectable sectors point at the drive itself, UDMA CRC errors at its cable, port or backplane, media errors at an NVMe drive.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "interval": "1h",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (node, device, attribute_name) (smartctl_device_attribute{node=~\"$node\", attribute_value_type=\"raw\", attribute_name=~\"Reallocated_Sector_Ct|Current_Pending_Sector|Offline_Uncorrectable|Reported_Uncorrect|UDMA_CRC_Error_Count\"} - smartctl_device_attribute{node=~\"$node\", attribute_value_type=\"raw\", attribute_name=~\"Reallocated_Sector_Ct|Current_Pending_Sector|Offline_Uncorrectable|Reported_Uncorrect|UDMA_CRC_Error_Count\"} offset $__interval) > 0",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} {{device}} {{attribute_name}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (node, device) (smartctl_device_media_errors{node=~\"$node\"} - smartctl_device_media_errors{node=~\"$node\"} offset $__interval) > 0",
          "instant": false,
          "range": true,
          "legendFormat": "{{node}} {{device}} media errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No new errors",
