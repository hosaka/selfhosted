{
  "uid": "backups",
  "title": "Backups",
  "description": "Restic repositories and each backup plan's latest snapshot, from restic-exporter. It refreshes hourly, so a backup shows up here within an hour of finishing.",
  "tags": [
    "backups",
    "storage"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5m",
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "repository",
        "label": "Repository",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(restic_snapshots_total, repository)",
          "refId": "repository"
        },
        "definition": "label_values(restic_snapshots_total, repository)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "plan",
        "label": "Plan",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(restic_backup_timestamp{repository=~\"$repository\"}, plan)",
          "refId": "plan"
        },
        "definition": "label_values(restic_backup_timestamp{repository=~\"$repository\"}, plan)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Plans",
      "description": "Backup plans with snapshots in the repositories.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(max by (repository, plan) (restic_backup_timestamp{repository=~\"$repository\", plan=~\"$plan\"}))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Stale plans",
      "description": "Plans whose latest snapshot is more than 26 hours old: a day between the 02:00 runs, plus up to an hour for the backup and an hour until the exporter's next refresh. A failed backup shows up here the morning after.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((time() - max by (repository, plan) (restic_backup_timestamp{repository=~\"$repository\", plan=~\"$plan\"})) > 93600) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Snapshots",
      "description": "Snapshots in each repository, all plans together.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "restic_snapshots_total{repository=~\"$repository\"}",
          "instant": true,
          "range": false,
          "legendFormat": "{{repository}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Stored",
      "description": "Size of each repository on disk, after deduplication and compression.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "restic_size_total{repository=~\"$repository\"}",
          "instant": true,
          "range": false,
          "legendFormat": "{{repository}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Compression",
      "description": "Uncompressed size of the stored data divided by its compressed size.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "restic_compression_ratio{repository=~\"$repository\"}",
          "instant": true,
          "range": false,
          "legendFormat": "{{repository}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Locks",
      "description": "Locks in each repository. Backrest holds one while a backup, forget, prune or check runs; one that's still there an hour later is probably left over from a run that crashed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "restic_locks_total{repository=~\"$repository\"}",
          "instant": true,
          "range": false,
          "legendFormat": "{{repository}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "justifyMode": "center",
        "colorMode": "background"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Plans",
      "description": "Each plan's latest snapshot. Size and Files are what that backup read, Added is the new data it stored after deduplication and compression, and Duration is restic's own time, without the hooks. Snapshots counts all of the plan's snapshots that retention has kept.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "last",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (repository, plan) (restic_backup_timestamp{repository=~\"$repository\", plan=~\"$plan\"}) * 1000",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "age",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max by (repository, plan) (restic_backup_timestamp{repository=~\"$repository\", plan=~\"$plan\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "snapshots",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (repository, plan) (restic_backup_snapshots_total{repository=~\"$repository\", plan=~\"$plan\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "size",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (repository, plan) (restic_backup_size_total{repository=~\"$repository\", plan=~\"$plan\"} and on (repository, plan, snapshot_hash) topk by (repository, plan) (1, restic_backup_timestamp{repository=~\"$repository\", plan=~\"$plan\"}))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "files",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (repository, plan) (restic_backup_files_total{repository=~\"$repository\", plan=~\"$plan\"} and on (repository, plan, snapshot_hash) topk by (repository, plan) (1, restic_backup_timestamp{repository=~\"$repository\", plan=~\"$plan\"}))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "added",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (repository, plan) (restic_backup_data_added_bytes{repository=~\"$repository\", plan=~\"$plan\"} and on (repository, plan, snapshot_hash) topk by (repository, plan) (1, restic_backup_timestamp{repository=~\"$repository\", plan=~\"$plan\"}))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "new",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (repository, plan) (restic_backup_files_new{repository=~\"$repository\", plan=~\"$plan\"} and on (repository, plan, snapshot_hash) topk by (repository, plan) (1, restic_backup_timestamp{repository=~\"$repository\", plan=~\"$plan\"}))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "changed",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (repository, plan) (restic_backup_files_changed{repository=~\"$repository\", plan=~\"$plan\"} and on (repository, plan, snapshot_hash) topk by (repository, plan) (1, restic_backup_timestamp{repository=~\"$repository\", plan=~\"$plan\"}))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "duration",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (repository, plan) (restic_backup_duration_seconds{repository=~\"$repository\", plan=~\"$plan\"} and on (repository, plan, snapshot_hash) topk by (repository, plan) (1, restic_backup_timestamp{repository=~\"$repository\", plan=~\"$plan\"}))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "repository": 0,
              "plan": 1,
              "Value #last": 2,
              "Value #age": 3,
              "Value #snapshots": 4,
              "Value #size": 5,
              "Value #files": 6,
              "Value #added": 7,
              "Value #new": 8,
              "Value #changed": 9,
              "Value #duration": 10
            },
            "renameByName": {
              "repository": "Repository",
              "plan": "Plan",
              "Value #last": "Last snapshot",
              "Value #age": "Age",
              "Value #snapshots": "Snapshots",
              "Value #size": "Size",
              "Value #files": "Files",
              "Value #added": "Added",
              "Value #new": "New files",
              "Value #changed": "Changed files",
              "Value #duration": "Duration"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last snapshot"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 93600
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Size"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Added"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Plan",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Repository size",
      "description": "Each repository's size on disk, and what its data would take uncompressed. It grows with each night's new data and drops after the weekly prune.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "restic_size_total{repository=~\"$repository\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{repository}} stored"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "restic_uncompressed_size_total{repository=~\"$repository\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{repository}} uncompressed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "stepAfter"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Snapshots",
      "description": "Snapshots in each repository. Retention keeps 7 daily, 4 weekly and 6 monthly per plan.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "restic_snapshots_total{repository=~\"$repository\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{repository}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "stepAfter"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Exporter refresh",
      "description": "How long the exporter's hourly refresh took, all of its restic commands together.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "restic_scrape_duration_seconds{repository=~\"$repository\"}",
          "instant": false,
          "range": true,
          "legendFormat": "{{repository}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "stepAfter"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Size by plan",
      "description": "What each plan's latest backup read.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (repository, plan) (restic_backup_size_total{repository=~\"$repository\", plan=~\"$plan\"} and on (repository, plan, snapshot_hash) topk by (repository, plan) (1, restic_backup_timestamp{repository=~\"$repository\", plan=~\"$plan\"}))",
          "instant": false,
          "range": true,
          "legendFormat": "{{plan}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "stepAfter"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "lastNotNull"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Added by plan",
      "description": "New data each plan's latest backup stored, after deduplication and compression.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (repository, plan) (restic_backup_data_added_bytes{repository=~\"$repository\", plan=~\"$plan\"} and on (repository, plan, snapshot_hash) topk by (repository, plan) (1, restic_backup_timestamp{repository=~\"$repository\", plan=~\"$plan\"}))",
          "instant": false,
          "range": true,
          "legendFormat": "{{plan}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "stepAfter"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Duration by plan",
      "description": "How long restic took for each plan's latest backup, without the hooks.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
