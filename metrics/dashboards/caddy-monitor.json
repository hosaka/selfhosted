      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 68
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{name=\"caddy\"} |= \"http.log.access\" | json | __error__=\"\" | request_host=~\"$host\" | line_format \"{{.status}} {{.request_method}} {{.request_host}}{{.request_uri}}  {{.request_client_ip}}  {{.duration}}s\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
