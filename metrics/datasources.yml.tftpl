apiVersion: 1

deleteDatasources:
  - name: Prometheus
    orgId: 1
  - name: Loki
    orgId: 1

datasources:
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    orgId: 1
    url: http://${prometheus_address}:${prometheus_port}
    editable: false
    isDefault: true
    basicAuth: false
    version: 1

  - name: Loki
    uid: loki
    type: loki
    access: proxy
    orgId: 1
    url: http://${loki_address}:${loki_port}
    editable: false
    basicAuth: false
    version: 1
