bindPort = 7000
tcpmuxHTTPConnectPort = 3912

allowPorts = [
  { single = 22 },
  { single = 80 },
  { single = 443 },
  { single = 5222 }, # XMPP Clients
  { single = 5269 }, # XMPP Federation
  { single = 5000 }, # Proxy65 File Transfers
  { single = 3478 }, { single = 3479 }, # STUN/TURN
  { single = 5349 }, { single = 5350 },  # STUNS/TURNS
  { single = 50300 }, # Slskd Transfers
  { start = 60000, end = 60010 } # TURN Data
]

auth.token = "{{ auth_token }}"
transport.maxPoolCount = 20

# admin dashboard
webServer.addr = "127.0.0.1"
webServer.port = 7500
webServer.user = "{{ dashboard_user }}"
webServer.password = "{{ dashboard_password }}"

enablePrometheus = true
