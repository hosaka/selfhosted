{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "custom.regex"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 0,
  "semanticCommits": "disabled",
  "commitMessageTopic": "{{{depName}}}",
  "commitMessageExtra": "to {{{newValue}}}",
  "packageRules": [
    {
      "description": "Registries other than Docker Hub return no release timestamps, so the age gate would hold these forever",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^[^/]+\\.[^/]+\\//"
      ],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions in versions.auto.tfvars with a `renovate:` annotation",
      "managerFilePatterns": [
        "/^versions\\.auto\\.tfvars$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?(?: versioning=(?<versioning>\\S+))?\\n\\s*\\w+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else if (equals datasource 'docker')}}docker{{else}}loose{{/if}}",
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.+)${{/if}}"
    }
  ]
}
